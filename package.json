    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "@playwright/test": "^1.52.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "storybook": "^8.6.14",
    "@storybook/vue3-vite": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
